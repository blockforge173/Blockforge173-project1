            {
                "personnage":"Bryan",
                "texte":"Pourquoi ?"
            },
            {
                "personnage":"Zoé",
                "texte":"Parce qu'après, on verra plus la voiture."
            },
            {
                "personnage":"Bryan",
                "texte":"Elle doit aller très vite."
            },
            {
                "personnage":"Zoé",
                "texte":"Je vais essayer."
